# ============================================================================
# Wordbee Clone — variáveis de ambiente
# Copie este arquivo para ".env" na raiz e preencha os valores.
# ============================================================================

# --- Banco de dados -----------------------------------------------------
# Com o docker-compose.yml de dev (usuário/senha "wordbee"):
DATABASE_URL="postgresql://wordbee:wordbee@localhost:5432/wordbee_dev"

# --- Redis (fila/agendamento com BullMQ) ---------------------------------
REDIS_URL="redis://localhost:6379"

# --- Autenticação (usuário único) ----------------------------------------
# Credenciais usadas pelo `npm run db:seed` para criar o único usuário do
# sistema. Depois do primeiro login, a senha pode ser trocada em Perfil.
ADMIN_EMAIL="voce@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha-no-minimo-8-chars"
ADMIN_NAME="Seu Nome"

# Segredo usado para assinar o cookie de sessão (JWT HS256).
# Gere com: openssl rand -base64 48
SESSION_SECRET=""

# Duração da sessão em horas.
SESSION_TTL_HOURS="168"

# Nome do cookie de sessão httpOnly.
SESSION_COOKIE_NAME="wordbee_session"

# --- Criptografia (chaves de API e senhas de aplicação WordPress) --------
# Chave-mestra AES-256-GCM: 32 bytes em base64.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Storage de imagens de referência (dev = disco local) ----------------
STORAGE_DRIVER="local"
# Use um caminho ABSOLUTO: o app web e o worker rodam em diretórios de
# trabalho diferentes, então um caminho relativo apontaria para lugares
# diferentes em cada processo.
STORAGE_LOCAL_PATH="/caminho/absoluto/para/wordbee-clone/storage/uploads"
# Em produção, troque para "s3" e preencha as credenciais abaixo:
# STORAGE_DRIVER="s3"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# --- Provedores de IA (BYOK — preenchidos depois, pela tela Chaves de API)
# Não é obrigatório definir aqui: as chaves reais dos provedores são
# cadastradas via UI e ficam criptografadas no banco. Estas variáveis abaixo
# só existem para uso em testes automatizados/CI (mocks).
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""
# XAI_API_KEY=""
# STABILITY_API_KEY=""

# Nomes de modelo por provedor (opcional — os padrões abaixo já são usados
# se você não definir nada aqui). Ver DECISIONS.md sobre nomes de modelo.
# OPENAI_TEXT_MODEL="gpt-4o"
# OPENAI_IMAGE_MODEL="dall-e-3"
# GEMINI_TEXT_MODEL="gemini-3.6-flash"
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# GROK_TEXT_MODEL="grok-2-latest"
# GROK_IMAGE_MODEL="grok-2-image"
# STABILITY_IMAGE_MODEL="sd3.5-large"

# --- Limite de concorrência por provedor de IA e do worker (RF-30) --------
# Quantas chamadas simultâneas de IA por provedor entre todas as linhas ativas.
AI_PROVIDER_CONCURRENCY="3"
# Quantas linhas o worker processa em paralelo (BullMQ Worker concurrency).
WORKER_CONCURRENCY="5"

# --- Rate limit de login ----------------------------------------------
LOGIN_RATE_LIMIT_MAX_ATTEMPTS="5"
LOGIN_RATE_LIMIT_WINDOW_MINUTES="15"

# --- Ambiente --------------------------------------------------------
# NÃO defina NODE_ENV aqui: next dev/build/start e o worker já definem o
# valor correto sozinhos. Sobrescrever via .env quebra "next build"
# (gera o bug conhecido "<Html> should not be imported outside of pages/_document").
PORT="3000"
