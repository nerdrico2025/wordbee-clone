# ============================================================================
# Wordbee Clone — variáveis de ambiente (desenvolvimento local)
# Copie este arquivo para ".env" na raiz e preencha os valores.
#
# Para produção (Vercel + worker/Postgres/Redis no EasyPanel), use
# ".env.production.example" como referência — a lista é a mesma, mas
# organizada por onde cada variável precisa ser configurada, e com o aviso
# sobre reaproveitar (não gerar de novo) a ENCRYPTION_KEY já em uso.
# ============================================================================

# --- Banco de dados -----------------------------------------------------
# Com o docker-compose.yml de dev (usuário/senha "wordbee"):
DATABASE_URL="postgresql://wordbee:wordbee@localhost:5432/wordbee_dev"

# --- Redis (rate limit de login + semáforo de concorrência por provedor de IA) ---
# Desde a migração do scheduler de Linhas de Produção para cron+Postgres
# (2026-08-30, ver DECISIONS.md "scheduler cron+Postgres"), o Redis não
# agenda/enfileira mais nada — usado só para rate limit de login, o
# semáforo `provider-slot:<provider>` e o heartbeat de saúde do worker.
REDIS_URL="redis://localhost:6379"

# --- Autenticação (usuário único) ----------------------------------------
# Credenciais usadas pelo `npm run db:seed` para criar o único usuário do
# sistema. Depois do primeiro login, a senha pode ser trocada em Perfil.
ADMIN_EMAIL="voce@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha-no-minimo-8-chars"
ADMIN_NAME="Seu Nome"

# Segredo usado para assinar o cookie de sessão (JWT HS256).
# Gere com: openssl rand -base64 48
SESSION_SECRET=""

# Duração da sessão em horas.
SESSION_TTL_HOURS="168"

# Nome do cookie de sessão httpOnly.
SESSION_COOKIE_NAME="wordbee_session"

# --- Criptografia (chaves de API e senhas de aplicação WordPress) --------
# Chave-mestra AES-256-GCM: 32 bytes em base64.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Storage de imagens de referência (dev = disco local) ----------------
STORAGE_DRIVER="local"
# Use um caminho ABSOLUTO: o app web e o worker rodam em diretórios de
# trabalho diferentes, então um caminho relativo apontaria para lugares
# diferentes em cada processo.
STORAGE_LOCAL_PATH="/caminho/absoluto/para/wordbee-clone/storage/uploads"
# Em produção, troque para "s3" e preencha as credenciais abaixo:
# STORAGE_DRIVER="s3"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# --- Provedores de IA (BYOK — preenchidos depois, pela tela Chaves de API)
# Não é obrigatório definir aqui: as chaves reais dos provedores são
# cadastradas via UI e ficam criptografadas no banco. Estas variáveis abaixo
# só existem para uso em testes automatizados/CI (mocks).
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""
# XAI_API_KEY=""
# STABILITY_API_KEY=""

# Nomes de modelo por provedor (opcional — os padrões abaixo já são usados
# se você não definir nada aqui). Ver DECISIONS.md sobre nomes de modelo.
# OPENAI_TEXT_MODEL="gpt-4o"
# OPENAI_IMAGE_MODEL="dall-e-3"
# GEMINI_TEXT_MODEL="gemini-3.6-flash"
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# GROK_TEXT_MODEL="grok-2-latest"
# GROK_IMAGE_MODEL="grok-2-image"
# STABILITY_IMAGE_MODEL="sd3.5-large"
# OPENROUTER_DEFAULT_MODEL="deepseek/deepseek-v4-flash-0731"
# OPENROUTER_IMAGE_DEFAULT_MODEL="google/gemini-2.5-flash-image"

# --- Limite de concorrência por provedor de IA e do worker (RF-30) --------
# Quantas chamadas simultâneas de IA por provedor entre todas as linhas ativas.
# Lida direto do env em cada chamada (apps/worker/src/provider-concurrency.ts)
# — pode ser reduzida temporariamente (ex.: "1" ou "2") como teste A/B pra
# isolar se timeouts do provedor vêm de carga simultânea, sem precisar mudar
# código nem rebuild, só a env var + restart do worker. Ver DECISIONS.md
# (2026-08-27, investigação de timeouts do OpenRouter em produção).
AI_PROVIDER_CONCURRENCY="3"
# Quantas linhas o scheduler cron+Postgres reivindica e processa em paralelo
# por tick (apps/worker/src/line-scheduler.ts).
WORKER_CONCURRENCY="5"

# --- Scheduler de Linhas de Produção (cron+Postgres) ----------------------
# A cada quantos ms o worker verifica no Postgres se há linhas ATIVA com
# nextRunAt vencido (apps/worker/src/line-scheduler.ts). Intervalos reais das
# linhas vão de 10min a 24h — não há motivo pra isso ser menor que ~1-2min.
# Ver DECISIONS.md "scheduler cron+Postgres".
SCHEDULER_INTERVAL_MS="90000"
# Depois de quanto tempo um lock de execução "travado" (worker morto/crashado
# no meio do processamento) é considerado morto e a linha volta a ser
# reivindicável (apps/worker/src/postgres-line-lock.ts).
LINE_LOCK_STALE_MS="1200000"

# --- Distribuição: Páginas do Facebook (trilho automático) ----------------
# Todas opcionais (os padrões abaixo já valem sem configurar nada). O ID e o
# token de Página NÃO ficam aqui: são cadastrados pela tela "Páginas do
# Facebook" e guardados criptografados no banco, como as chaves de IA.
# FACEBOOK_GRAPH_VERSION="v21.0"
# DISTRIBUTION_SCHEDULER_INTERVAL_MS="120000"
# Janela de "artigo recém-publicado" da varredura — impede que o primeiro
# deploy da feature gere pacote (e custo de IA) para todo o histórico.
# DISTRIBUTION_LOOKBACK_MS="21600000"
# Atraso da primeira publicação e espaçamento entre Páginas do mesmo pacote.
# DISTRIBUTION_FIRST_POST_DELAY_MS="300000"
# DISTRIBUTION_PAGE_SPACING_MS="600000"
# DISTRIBUTION_PACKAGE_CONCURRENCY="3"
# DISTRIBUTION_PUBLISH_CONCURRENCY="3"
# DISTRIBUTION_MAX_BUILD_ATTEMPTS="3"
# DISTRIBUTION_MAX_PUBLISH_ATTEMPTS="3"
# DISTRIBUTION_RETRY_BASE_MS="300000"
# DISTRIBUTION_RATE_LIMIT_DEFER_MS="3600000"
# DISTRIBUTION_LOCK_STALE_MS="600000"
# Quantas variações de copy pedir por pacote (numa chamada de IA só).
# DISTRIBUTION_COPY_VARIACOES="3"

# --- Distribuição: trilho assistido (grupos, perfis, links rastreados) ----
# URL pública do app — é a base dos links curtos rastreados (/r/{codigo})
# que vão na copy do comentário postado nos grupos. Sem ela, o app deriva
# dos headers da requisição, o que já funciona em localhost; em produção,
# defina explicitamente para o link não depender do proxy.
# APP_PUBLIC_URL="http://localhost:3000"
# Fuso usado para decidir "que dia é hoje" na Fila de Distribuição. Sem
# isto, o servidor (UTC) viraria o dia às 21h de Brasília e a fila mudaria
# embaixo de quem ainda está trabalhando à noite.
# APP_TIMEZONE="America/Sao_Paulo"

# --- Rate limit de login ----------------------------------------------
LOGIN_RATE_LIMIT_MAX_ATTEMPTS="5"
LOGIN_RATE_LIMIT_WINDOW_MINUTES="15"

# --- Ambiente --------------------------------------------------------
# NÃO defina NODE_ENV aqui: next dev/build/start e o worker já definem o
# valor correto sozinhos. Sobrescrever via .env quebra "next build"
# (gera o bug conhecido "<Html> should not be imported outside of pages/_document").
PORT="3000"
