# ============================================================================
# Wordbee Clone — variáveis de ambiente de PRODUÇÃO
# ============================================================================
# Este projeto roda em QUATRO serviços ao mesmo tempo, sem Railway (ver
# README.md "Deploy no EasyPanel" e DECISIONS.md "Estado final da
# infraestrutura de produção — Railway descontinuada"):
#   - app "web" (Next.js) -> Vercel
#   - "worker" (BullMQ)   -> EasyPanel (Docker, VPS próprio) — único serviço
#     com estado nenhum no VPS; sem Postgres/Redis locais.
#   - Postgres            -> Neon (gerenciado, externo)
#   - Redis (fila BullMQ + rate limit de login) -> Upstash (gerenciado,
#     externo — NÃO um Redis dentro do EasyPanel, ver aviso em REDIS_URL)
#
# Este arquivo é só um TEMPLATE — não tem valores reais. Cada bloco abaixo
# indica ONDE a variável precisa ser configurada (painel da Vercel ou painel
# do EasyPanel/serviço "worker"). Web e worker precisam compartilhar os
# valores IDÊNTICOS de DATABASE_URL, REDIS_URL e ENCRYPTION_KEY — os dois
# processos leem/escrevem no mesmo banco (Neon) e na mesma fila (Upstash).
#
# NÃO copie este arquivo para ".env" em produção com os valores daqui —
# são placeholders. Gere/obtenha cada valor real conforme indicado.
# ============================================================================


# ---------------------------------------------------------------------------
# Compartilhadas (mesmo valor na Vercel E no EasyPanel/worker)
# ---------------------------------------------------------------------------

# Conexão com o Postgres — em produção, a connection string do Neon
# (gerenciado, externo, endpoint público com TLS por padrão). Não roda no
# EasyPanel: o Postgres precisa ser alcançável tanto pela Vercel (IP de
# saída dinâmico) quanto pelo worker, e o Neon já é feito pra isso.
DATABASE_URL="postgresql://usuario:SENHA@SEU-ENDPOINT.neon.tech/wordbee?sslmode=require"

# Conexão TCP nativa do Redis (não é REST) — usada tanto para a fila BullMQ
# das Linhas de Produção (produzida pelo web, consumida pelo worker) quanto
# para o rate limit de login (só o web usa isso). Uma única REDIS_URL para
# os dois usos (ver DECISIONS.md "REDIS_URL única para fila BullMQ e rate
# limit" — decisão consciente, não um descuido).
#
# ⚠️ Use uma instância Upstash externa aqui, NÃO o template de Redis do
# EasyPanel. Motivo: o web (Vercel, produtor dos jobs) e o worker
# (EasyPanel, consumidor) precisam falar com o MESMO Redis, e a Vercel roda
# com IP de saída dinâmico — não dá para confiar em restringir por IP o
# Redis interno do EasyPanel para ela alcançar, e deixar aberto pra
# qualquer IP é arriscado. Upstash já resolve isso com endpoint público
# TLS. **Cole exatamente o mesmo valor aqui e no ambiente da Vercel** — se
# divergir, o worker nunca vê os jobs que o web agenda (linhas de produção
# param silenciosamente, sem erro visível em nenhum dos dois lados).
REDIS_URL="rediss://default:SENHA@SEU-ENDPOINT.upstash.io:6379"

# Chave-mestra AES-256-GCM (32 bytes em base64) que criptografa api_keys e
# wp_sites.app_password_encrypted no banco.
# Gere com: openssl rand -base64 32
#
# ⚠️ CRÍTICO: esta chave NÃO pode ser gerada de novo nem divergir entre
# Vercel e worker (EasyPanel). Precisa ser EXATAMENTE a mesma nos dois —
# se mudar, todo o conteúdo já criptografado no banco (chaves de API dos
# provedores de IA e senhas de aplicação do WordPress) fica permanentemente
# ilegível. Copie o valor atual do painel da Vercel (Settings ->
# Environment Variables -> ENCRYPTION_KEY) para o worker, não gere um novo
# com o comando acima. Ver README.md ("Backup e restauração do banco").
ENCRYPTION_KEY=""

# Overrides de modelo por provedor de IA — opcionais, mas mantenha
# IDÊNTICOS entre Vercel e worker para não ter comportamento divergente
# entre a geração unitária (web) e as Linhas de Produção (worker).
# OPENAI_TEXT_MODEL="gpt-4o"
# OPENAI_IMAGE_MODEL="dall-e-3"
# GEMINI_TEXT_MODEL="gemini-3.6-flash"
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# GROK_TEXT_MODEL="grok-2-latest"
# GROK_IMAGE_MODEL="grok-2-image"
# STABILITY_IMAGE_MODEL="sd3.5-large"
# OPENROUTER_DEFAULT_MODEL="deepseek/deepseek-v4-flash-0731"
# OPENROUTER_IMAGE_DEFAULT_MODEL="google/gemini-2.5-flash-image"


# ---------------------------------------------------------------------------
# Só na Vercel (app web) — configurar em Project Settings -> Environment
# Variables. Ver detalhamento completo em VERCEL-ENV.md.
# ---------------------------------------------------------------------------

# Assina o cookie de sessão (JWT HS256). Só o web usa.
# Gere com: openssl rand -base64 48
SESSION_SECRET=""

# Duração da sessão em horas. Opcional, padrão 168 (7 dias).
SESSION_TTL_HOURS="168"

# Nome do cookie httpOnly de sessão. Opcional, padrão "wordbee_session".
SESSION_COOKIE_NAME="wordbee_session"

# Rate limit de tentativas de login. Opcionais.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS="5"
LOGIN_RATE_LIMIT_WINDOW_MINUTES="15"


# ---------------------------------------------------------------------------
# Só no EasyPanel, serviço "worker" — configurar nas Environment Variables
# do serviço no painel do EasyPanel.
# ---------------------------------------------------------------------------

# Storage de imagens de referência. Só "local" está implementado hoje.
# ⚠️ Com web na Vercel (filesystem efêmero) e worker no VPS, os dois NÃO
# compartilham disco: se cadastrar Imagens de Referência em Linhas de
# Produção, o worker só enxerga o que foi salvo no disco DELE, não o que a
# Vercel recebeu. Sem driver S3 implementado ainda, evite Imagens de
# Referência em Linhas de Produção nesse cenário (funciona normalmente na
# geração unitária, onde tudo roda na Vercel).
STORAGE_DRIVER="local"
# Caminho ABSOLUTO dentro do container do worker no EasyPanel — bata com o
# volume persistente configurado no serviço (ex.: monte um volume em
# /repo/storage/uploads e use esse mesmo caminho aqui).
STORAGE_LOCAL_PATH="/repo/storage/uploads"

# Concorrência de chamadas de IA por provedor entre todas as linhas ativas.
# Ajustável sem redeploy de código — só mudar a env var e reiniciar o worker
# (ex.: reduzir pra "1" ou "2" temporariamente como teste A/B pra isolar se
# timeouts do provedor vêm de carga simultânea). Ver DECISIONS.md.
AI_PROVIDER_CONCURRENCY="3"

# Quantas linhas o worker processa em paralelo (BullMQ Worker concurrency).
WORKER_CONCURRENCY="5"


# ---------------------------------------------------------------------------
# Só localmente, uma vez (nunca em produção) — usadas por `npm run db:seed`
# rodado da sua máquina, apontando DATABASE_URL para o Postgres de
# produção, para criar o usuário único. Depois do primeiro login, troque a
# senha em Perfil. NÃO configure isso como env var permanente em nenhuma
# plataforma.
# ---------------------------------------------------------------------------
# ADMIN_EMAIL="voce@exemplo.com"
# ADMIN_PASSWORD="troque-esta-senha-no-minimo-8-chars"
# ADMIN_NAME="Seu Nome"


# ---------------------------------------------------------------------------
# NÃO precisam de env var em nenhuma plataforma
# ---------------------------------------------------------------------------
# OPENAI_API_KEY, GEMINI_API_KEY, XAI_API_KEY, STABILITY_API_KEY — o app é
# BYOK: chaves reais são cadastradas pela tela "Chaves de API" dentro do
# app e ficam criptografadas no banco (com ENCRYPTION_KEY acima).
#
# PORT — a Vercel gerencia sozinha; o worker não expõe porta HTTP (não é
# um serviço web, só consome a fila BullMQ).
#
# NODE_ENV — nunca defina manualmente em nenhuma plataforma (Next.js e o
# worker já escolhem o valor certo sozinhos; sobrescrever quebra o build).
